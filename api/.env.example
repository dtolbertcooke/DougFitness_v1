# api/.env.example
# Copy to .env for local development. .env is gitignored; never commit real values.
# Read and validated by src/config/env.ts (Phase 1).

NODE_ENV=development
PORT=8080

# Atlas connection string for the DougFitness-dev user (created in Phase 1).
MONGODB_URI=mongodb+srv://liftlog-dev:<password>@<cluster>.mongodb.net/liftlog_dev

# 32+ random characters. Generate with: openssl rand -base64 48
JWT_SECRET=

# Optional — defaults are set in env.ts if you leave these out.
JWT_TTL=7d
LOG_LEVEL=info